{
  "name": "mistcoat-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Mistcoat for Android, iOS and the web: protect artwork from AI training, on-device.",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
